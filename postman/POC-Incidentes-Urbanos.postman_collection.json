{
  "info": {
    "name": "POC Incidentes Urbanos IA",
    "description": "Coleccion para validar registro, clasificacion, asignacion y seguimiento de incidentes urbanos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "incidentId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminIncidentId", "value": "" }
  ],
  "item": [
    {
      "name": "Healthcheck",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Clasificar descripcion",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Hay basura acumulada y mucho olor junto al contenedor.\"\n}" },
        "url": "{{baseUrl}}/api/classifications"
      }
    },
    {
      "name": "Asignar por clasificacion",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"classification\": {\n    \"category\": \"infraestructura_vial\",\n    \"priority\": \"media\"\n  }\n}" },
        "url": "{{baseUrl}}/api/assignments"
      }
    },
    {
      "name": "Registrar incidente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.incident && json.incident.id) pm.collectionVariables.set('incidentId', json.incident.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"municipalityId\": \"demo-municipio\",\n  \"citizenName\": \"Manuel Krivoy\",\n  \"contact\": \"manuel@example.com\",\n  \"address\": \"Av. Principal 123\",\n  \"description\": \"Hay un bache profundo que bloquea media calle y genera riesgo de accidente.\"\n}" },
        "url": "{{baseUrl}}/api/incidents"
      }
    },
    {
      "name": "Listar incidentes",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents" }
    },
    {
      "name": "Consultar incidente por ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/incidents/{{incidentId}}" }
    },
    {
      "name": "Actualizar estado",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"en_proceso\",\n  \"comment\": \"Cuadrilla municipal asignada para resolver el reclamo.\"\n}" },
        "url": "{{baseUrl}}/api/incidents/{{incidentId}}/status"
      }
    },
    {
      "name": "Admin - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('adminToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}" },
        "url": "{{baseUrl}}/api/admin/login"
      }
    },
    {
      "name": "Admin - Crear administrador",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"nuevo-admin@example.com\",\n  \"password\": \"nuevo123\"\n}" },
        "url": "{{baseUrl}}/api/admin"
      }
    },
    {
      "name": "Admin - Crear incidente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.incident && json.incident.id) pm.collectionVariables.set('adminIncidentId', json.incident.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"municipalityId\": \"demo-municipio\",\n  \"citizenName\": \"Operador Admin\",\n  \"contact\": \"admin@example.com\",\n  \"address\": \"Calle Admin 456\",\n  \"description\": \"Hay basura acumulada con mucho olor en la esquina.\"\n}" },
        "url": "{{baseUrl}}/api/admin/incidents"
      }
    },
    {
      "name": "Admin - Listar incidentes",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/admin/incidents"
      }
    },
    {
      "name": "Admin - Consultar incidente por ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/admin/incidents/{{adminIncidentId}}"
      }
    },
    {
      "name": "Admin - Actualizar incidente",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"citizenName\": \"Operador Admin Editado\",\n  \"address\": \"Calle Admin 789\",\n  \"description\": \"La calle tiene un bache profundo y peligroso.\",\n  \"status\": \"en_proceso\",\n  \"comment\": \"Actualizacion administrativa del incidente.\"\n}" },
        "url": "{{baseUrl}}/api/admin/incidents/{{adminIncidentId}}"
      }
    },
    {
      "name": "Admin - Eliminar incidente",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/admin/incidents/{{adminIncidentId}}"
      }
    }
  ]
}
